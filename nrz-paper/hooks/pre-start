#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzPaper kommt ohne eigenes Image und ohne Registry-Login: Programm (mit Oberflaeche),
# Texterkennung (Tesseract Deutsch/Englisch, Poppler und ihre Bibliotheken) und start.sh
# liegen im oeffentlichen Paket-Repo nrzPaper-umbrel auf nrzGit auf diesem Geraet (nur
# fertige Dateien, Quellcode in nrzPaper; Tag unten). Beim ersten Start und nach Updates
# werden sie fuer die Architektur dieses Geraets nach app/ geladen und geprueft; der
# Container (gepinntes debian:bookworm-slim) startet sie von dort.
RELEASE="umbrel-1.0.0"
BASE="http://localhost:8390/nicorenezweers/nrzPaper-umbrel/raw/tag/${RELEASE}"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzPaper: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

mkdir -p "${APP_DIR}/data"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi
  }
  for f in SHA256SUMS "nrzpaper-${ARCH}.gz" "ocr-${ARCH}.tar.gz" Rocket.toml start.sh; do
    fetch "$f" || return 1
  done
  (cd "${TMP}" && grep -E " (nrzpaper-${ARCH}\.gz|ocr-${ARCH}\.tar\.gz|Rocket\.toml|start\.sh)$" SHA256SUMS | sha256sum -c --quiet -) || return 1

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}"
  gunzip -c "${TMP}/nrzpaper-${ARCH}.gz" > "${NEW}/nrzpaper"
  tar -xzf "${TMP}/ocr-${ARCH}.tar.gz" -C "${NEW}" --no-same-owner
  cp "${TMP}/Rocket.toml" "${TMP}/start.sh" "${NEW}/"
  chmod 755 "${NEW}/nrzpaper" "${NEW}/start.sh"
  chmod -R a+rX "${NEW}"
  echo "${RELEASE}-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "${RELEASE}-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrzpaper" ]; then
      echo "nrzPaper: ${RELEASE} nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzPaper: Programm nicht von nrzGit (Port 8390) ladbar – ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

# Datenbank und Eingangsordner schreibt der Container als 1000.
chown 1000:1000 "${APP_DIR}/data" 2>/dev/null || true
