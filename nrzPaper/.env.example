# nrzPaper – Umgebungsvariablen (in .env kopieren und anpassen)
# Wird von docker-compose.yml nicht direkt geladen; hier als Referenz.

# Eigener verschlüsselter DB-Schlüssel (64 Hex oder lange Passphrase)
# Ohne diesen Wert wird automatisch einer erstellt unter /data/nrzpaper.key
NRZPAPER_DB_KEY=

# Tesseract OCR-Sprachen
NRZPAPER_OCR_LANGUAGES=deu+eng

# Adresse / Port
NRZPAPER_ADDRESS=0.0.0.0
NRZPAPER_PORT=8320

# Loglevel
NRZPAPER_LOG=info

# Cookie nur über HTTPS senden (hinter Reverse-Proxy auf true stellen)
NRZPAPER_COOKIE_SECURE=false

# Selbstregistrierung erlauben
NRZPAPER_REGISTRATION_OPEN=false
