#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzAnalytics kommt ohne eigenes Image und ohne Registry-Login: das statische Programm (Rust,
# Oberflaeche eingebettet) liegt im nrzAnalytics-Repo auf nrzGit auf diesem Geraet (Zweig `umbrel`,
# Tag unten, gebaut mit `cargo xtask umbrel-release`). Beim ersten Start und nach Updates wird es
# fuer die Architektur dieses Geraets nach app/ geladen und geprueft.
RELEASE="umbrel-1.0.0"
BASE="http://localhost:8390/nicorenezweers/nrzAnalytics/raw/tag/${RELEASE}"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzAnalytics: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

FILE="nrzanalytics-${ARCH}.gz"
PATTERN=" nrzanalytics-${ARCH}\.gz$"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi || { echo "nrzAnalytics: ${BASE}/$1 nicht ladbar" >&2; return 1; }
  }
  fetch SHA256SUMS || return 1
  fetch "${FILE}" || return 1
  [ "$(grep -c "${PATTERN}" "${TMP}/SHA256SUMS")" = 1 ] || return 1
  (cd "${TMP}" && grep "${PATTERN}" SHA256SUMS | sha256sum -c --quiet -) || return 1

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}"
  gunzip -c "${TMP}/${FILE}" > "${NEW}/nrzanalytics"
  chmod 755 "${NEW}/nrzanalytics"
  chmod -R a+rX "${NEW}"
  echo "${RELEASE}-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "${RELEASE}-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrzanalytics" ]; then
      echo "nrzAnalytics: ${RELEASE} nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzAnalytics: Programm nicht von nrzGit (Port 8390) ladbar - ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

# SQLite-Datenbank (analytics.db + WAL) und GeoIP-Daten gehoeren dem Server-Benutzer 1000.
mkdir -p "${APP_DIR}/data"
chown -R 1000:1000 "${APP_DIR}/data" 2>/dev/null || true
