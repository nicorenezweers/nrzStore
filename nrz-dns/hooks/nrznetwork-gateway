#!/usr/bin/env bash
# nrzNetwork-Waechter fuer umbrelOS (laeuft auf dem Geraet, gestartet von hooks/pre-start).
#
# * Schreibt die Adressen des Geraets (LAN, NetBird/Tailscale ...) nach data/host-addresses,
#   damit nrzNetwork jedem Client die passende Adresse nennt.
# * Gibt Port 80 des Geraets an den Reverse Proxy von nrzNetwork (Container-Port 81), solange
#   der Proxy auf /.nrznetwork/health antwortet: eigene iptables-Kette NRZNETWORK in
#   nat/PREROUTING, DNAT tcp/80 -> <Container-IP>:81, nicht fuer lo, docker0, br-*, veth*
#   (Container erreichen umbrelOS also weiter direkt). Alles ohne Eintrag reicht der Proxy an
#   umbrelOS weiter (NRZDNS_PROXY_FALLBACK).
# * Steht in data/tls-active "on" (nrzNetwork hat ein HTTPS-Zertifikat) und nimmt der
#   HTTPS-Eingang (Container-Port 444) Verbindungen an, geht auch tcp/443 dorthin. Namen ohne
#   eigenes Zertifikat reicht nrzNetwork unveraendert an umbrelOS (Port 443) weiter.
# * Antwortet der Proxy zweimal nicht, steht in data/port80 "off", ist der Container weg oder
#   endet der Waechter, wird die Kette sofort entfernt - Port 80 gehoert dann wieder umbrelOS.
#
# Aufruf: nrznetwork-gateway <APP_DATA_DIR>
set -u

APP_DIR="${1:?APP_DATA_DIR fehlt}"
DATA="${APP_DIR}/data"
CONTAINER="${NRZ_CONTAINER:-nrz-dns_app_1}"
CHAIN="NRZNETWORK"
# NetBird im Userspace-Modus (umbrelOS-App, laeuft als Benutzer 1000 im Host-Netz) reicht
# Verbindungen an seine Adresse lokal weiter - die laufen durch nat/OUTPUT, nicht PREROUTING.
OUT_CHAIN="NRZNETWORK_OUT"
NETBIRD="${NRZ_NETBIRD:-netbird_app_1}"
PORT=81
TLS_PORT=444
LOG="${DATA}/gateway.log"
STATE="${DATA}/gateway.json"
PIDFILE="${DATA}/gateway.pid"
INTERVAL="${NRZ_INTERVAL:-5}"

mkdir -p "${DATA}"
echo $$ > "${PIDFILE}"

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "${LOG}"
  if [ "$(wc -c < "${LOG}" 2>/dev/null || echo 0)" -gt 200000 ]; then
    tail -n 400 "${LOG}" > "${LOG}.tmp" && mv -f "${LOG}.tmp" "${LOG}"
  fi
}

state() {
  printf '{"active":%s,"message":"%s","updatedAt":%s}\n' "$1" "$2" "$(date +%s)" > "${STATE}.tmp" \
    && mv -f "${STATE}.tmp" "${STATE}"
  chown 1000:1000 "${STATE}" 2>/dev/null || true
}

if ! command -v iptables >/dev/null 2>&1; then
  log "iptables fehlt - Port 80 bleibt bei umbrelOS"
  state false "iptables fehlt auf dem Geraet"
  exit 1
fi

remove_out() {
  while iptables -w -t nat -D OUTPUT -j "${OUT_CHAIN}" 2>/dev/null; do :; done
  iptables -w -t nat -F "${OUT_CHAIN}" 2>/dev/null || true
  iptables -w -t nat -X "${OUT_CHAIN}" 2>/dev/null || true
}

remove_rules() {
  while iptables -w -t nat -D PREROUTING -j "${CHAIN}" 2>/dev/null; do :; done
  iptables -w -t nat -F "${CHAIN}" 2>/dev/null || true
  iptables -w -t nat -X "${CHAIN}" 2>/dev/null || true
  remove_out
}

# Benutzer, als der NetBird laeuft (nur wenn nicht root - root heisst Kernel-Modus mit eigenem
# Interface, das PREROUTING schon abdeckt).
netbird_uid() {
  local u
  u="$(docker inspect -f '{{.Config.User}}' "${NETBIRD}" 2>/dev/null | cut -d: -f1)"
  case "${u}" in
    '' | 0 | root) return 1 ;;
    *[!0-9]*) return 1 ;;
    *) echo "${u}" ;;
  esac
}

netbird_ip() {
  # Nur die eigene Adresse: sie steht mit Praefix da ("100.78.107.162/16"), die der anderen
  # Geraete (peers) ohne.
  docker exec "${NETBIRD}" netbird status --json 2>/dev/null \
    | grep -oE '"netbirdIp": *"[0-9.]+/[0-9]+"' | grep -oE '[0-9]+(\.[0-9]+){3}' | head -n 1
}

# Lokale Verbindungen von NetBird auf Port 80 an den Proxy (ueber den veroeffentlichten
# Port 81). Danach Selbsttest als dieser Benutzer: kommt nicht die Antwort des Proxys,
# wird die Regel wieder entfernt.
install_out() {
  local uid="$1" tls="$2"
  iptables -w -t nat -N "${OUT_CHAIN}" 2>/dev/null || iptables -w -t nat -F "${OUT_CHAIN}" || return 1
  iptables -w -t nat -A "${OUT_CHAIN}" -p tcp --dport 80 -m addrtype --dst-type LOCAL \
    -m owner --uid-owner "${uid}" -j REDIRECT --to-ports "${PORT}" || return 1
  if [ "${tls}" = "on" ]; then
    iptables -w -t nat -A "${OUT_CHAIN}" -p tcp --dport 443 -m addrtype --dst-type LOCAL \
      -m owner --uid-owner "${uid}" -j REDIRECT --to-ports "${TLS_PORT}" || return 1
  fi
  iptables -w -t nat -C OUTPUT -j "${OUT_CHAIN}" 2>/dev/null \
    || iptables -w -t nat -I OUTPUT 1 -j "${OUT_CHAIN}" || return 1
  as_user "${uid}" "exec 3<>/dev/tcp/127.0.0.1/80 \
    && printf 'GET /.nrznetwork/health HTTP/1.0\r\nHost: nrznetwork\r\n\r\n' >&3 \
    && grep -q nrznetwork-ok <&3"
}

# Befehl als dieser Benutzer (fuer den Selbsttest). Geht das nicht, gilt der Test als
# fehlgeschlagen - die Regel wird dann nicht gesetzt.
as_user() {
  local uid="$1" cmd="$2" name
  if setpriv --help 2>&1 | grep -q -- '--reuid'; then
    setpriv --reuid="${uid}" --regid="${uid}" --clear-groups timeout 3 bash -c "${cmd}" 2>/dev/null
    return
  fi
  name="$(getent passwd "${uid}" 2>/dev/null | cut -d: -f1)"
  [ -n "${name}" ] || return 1
  timeout 3 su -s /bin/bash "${name}" -c "${cmd}" 2>/dev/null
}

install_rules() {
  local ip="$1" tls="$2"
  iptables -w -t nat -N "${CHAIN}" 2>/dev/null || iptables -w -t nat -F "${CHAIN}" || return 1
  local i
  for i in lo docker0 'br-+' 'veth+'; do
    iptables -w -t nat -A "${CHAIN}" -i "${i}" -j RETURN || return 1
  done
  iptables -w -t nat -A "${CHAIN}" -p tcp --dport 80 -m addrtype --dst-type LOCAL \
    -j $(target "${ip}" "${PORT}") || return 1
  if [ "${tls}" = "on" ]; then
    iptables -w -t nat -A "${CHAIN}" -p tcp --dport 443 -m addrtype --dst-type LOCAL \
      -j $(target "${ip}" "${TLS_PORT}") || return 1
  fi
  iptables -w -t nat -C PREROUTING -j "${CHAIN}" 2>/dev/null \
    || iptables -w -t nat -I PREROUTING 1 -j "${CHAIN}" || return 1
}

# HTTPS-Eingang nimmt Verbindungen an?
tls_listening() {
  timeout 2 bash -c "exec 3<>/dev/tcp/$1/${TLS_PORT}" 2>/dev/null
}

# Host-Modus: der Container teilt das Netz des Geraets – dann zaehlt 127.0.0.1.
container_ip() {
  local mode running
  running="$(docker inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null)"
  [ "${running}" = "true" ] || return 0
  mode="$(docker inspect -f '{{.HostConfig.NetworkMode}}' "${CONTAINER}" 2>/dev/null)"
  if [ "${mode}" = "host" ]; then
    echo 127.0.0.1
    return 0
  fi
  docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "${CONTAINER}" 2>/dev/null \
    | awk '{print $1}'
}

# Ziel einer Regel: im Host-Modus lokal umleiten, sonst an die Container-Adresse.
target() {
  local ip="$1" port="$2"
  if [ "${ip}" = "127.0.0.1" ]; then
    echo "REDIRECT --to-ports ${port}"
  else
    echo "DNAT --to-destination ${ip}:${port}"
  fi
}

healthy() {
  local ip="$1"
  timeout 3 bash -c "exec 3<>/dev/tcp/${ip}/${PORT} \
    && printf 'GET /.nrznetwork/health HTTP/1.0\r\nHost: nrznetwork\r\n\r\n' >&3 \
    && grep -q nrznetwork-ok <&3" 2>/dev/null
}

IFACE_SKIP='^(docker|br-|veth|lo|virbr|vnet|tap|cni|flannel|kube|lxc|lxd|umbrel-vm)'

host_addresses() {
  {
    ip -o -4 addr show scope global 2>/dev/null \
      | awk -v skip="${IFACE_SKIP}" '$2 !~ skip { split($4, a, "/"); print a[1] }'
    netbird_ip
  } | sort -u
}

host_interfaces() {
  ip -o -4 addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); printf "%s=%s ", $2, a[1] }'
}

cleanup() {
  remove_rules
  state false "Waechter beendet"
  log "Waechter beendet - Port 80 gehoert wieder umbrelOS"
  rm -f "${PIDFILE}"
  exit 0
}
trap cleanup TERM INT HUP

log "Waechter gestartet (PID $$)"
remove_rules
log "Interfaces: $(host_interfaces)"
active=""
out_state=""
fails=0
missing=0
last_addrs=""
tick=0

while :; do
  if [ $((tick % 6)) -eq 0 ]; then
    addrs="$(host_addresses)"
    if [ -n "${addrs}" ] && [ "${addrs}" != "${last_addrs}" ]; then
      printf '%s\n' ${addrs} > "${DATA}/host-addresses.tmp" && mv -f "${DATA}/host-addresses.tmp" "${DATA}/host-addresses"
      chown 1000:1000 "${DATA}/host-addresses" 2>/dev/null || true
      log "Adressen des Geraets: $(echo ${addrs})"
      last_addrs="${addrs}"
    fi
  fi
  tick=$((tick + 1))

  flag="$({ tr -d '[:space:]' < "${DATA}/port80"; } 2>/dev/null || echo on)"
  cip="$(container_ip)"

  if [ -z "${cip}" ]; then
    missing=$((missing + 1))
    if [ -n "${active}" ]; then
      remove_rules; active=""
      log "Container ohne Adresse - Port 80 zurueck an umbrelOS"
    fi
    state false "nrzNetwork laeuft nicht"
    if [ "${missing}" -ge 60 ]; then
      log "Container seit 5 Minuten weg - Waechter endet"
      cleanup
    fi
  elif [ "${flag}" = "off" ]; then
    missing=0
    if [ -n "${active}" ]; then
      remove_rules; active=""
      log "Port 80 ausgeschaltet"
    fi
    state false "Ausgeschaltet - Port 80 gehoert umbrelOS"
  elif healthy "${cip}"; then
    missing=0; fails=0
    tls="$({ tr -d '[:space:]' < "${DATA}/tls-active"; } 2>/dev/null || echo off)"
    if [ "${tls}" = "on" ] && ! tls_listening "${cip}"; then
      tls="off"
    fi
    if [ -n "${active}" ] && ! iptables -w -t nat -C PREROUTING -j "${CHAIN}" 2>/dev/null; then
      active=""
    fi
    if [ "${active}" != "${cip}/${tls}" ]; then
      if install_rules "${cip}" "${tls}"; then
        active="${cip}/${tls}"
        out_state=""
        if [ "${tls}" = "on" ]; then
          log "Port 80 -> ${cip}:${PORT}, Port 443 -> ${cip}:${TLS_PORT}"
        else
          log "Port 80 -> ${cip}:${PORT} (443 bleibt bei umbrelOS)"
        fi
      else
        remove_rules; active=""
        log "Regeln setzen fehlgeschlagen - Port 80 bleibt bei umbrelOS"
      fi
    fi
    # NetBird (Userspace): einmal je Aktivierung versuchen, sonst alle 5 Minuten neu
    if [ -n "${active}" ] && { [ -z "${out_state}" ] || { [ "${out_state}" = "aus" ] && [ $((tick % 60)) -eq 0 ]; }; }; then
      if nb_uid="$(netbird_uid)"; then
        if install_out "${nb_uid}" "${tls}"; then
          out_state="an"
          log "NetBird (Benutzer ${nb_uid}): Port 80$([ "${tls}" = on ] && echo ' und 443') -> Proxy"
        else
          remove_out; out_state="aus"
          log "NetBird-Weiterleitung greift nicht - NetBird-Port 80 bleibt bei umbrelOS"
        fi
      else
        out_state="keins"
      fi
    fi
    if [ -n "${active}" ]; then
      if [ "${tls}" = "on" ]; then
        state true "Port 80 und 443 zeigen auf den Proxy (${cip})"
      else
        state true "Port 80 zeigt auf den Proxy (${cip}:${PORT})"
      fi
    else
      state false "Regeln liessen sich nicht setzen"
    fi
  else
    missing=0
    fails=$((fails + 1))
    if [ -n "${active}" ] && [ "${fails}" -ge 2 ]; then
      remove_rules; active=""
      log "Proxy antwortet nicht - Port 80 zurueck an umbrelOS"
    fi
    [ -z "${active}" ] && state false "Proxy antwortet (noch) nicht - Port 80 gehoert umbrelOS"
  fi

  sleep "${INTERVAL}" &
  wait $!
done
