#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzPGP kommt ohne eigenes Image und ohne Registry-Login: Server (Rust) und Oberflaeche
# (Dioxus/WASM) liegen im nrzPGP-Repo auf nrzGit auf diesem Geraet (Zweig `umbrel`, Tag unten,
# gebaut mit scripts/umbrel-release.sh). Beim ersten Start und nach Updates werden sie fuer die
# Architektur dieses Geraets nach app/ geladen und geprueft.
RELEASE="umbrel-1.0.0"
BASE="http://localhost:8390/nicorenezweers/nrzPGP/raw/tag/${RELEASE}"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzPGP: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

FILES="nrzpgp-${ARCH}.gz web.tar.gz cap.tar.gz"
PATTERN=" nrzpgp-${ARCH}\.gz$| web\.tar\.gz$| cap\.tar\.gz$"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi || { echo "nrzPGP: ${BASE}/$1 nicht ladbar" >&2; return 1; }
  }
  fetch SHA256SUMS || return 1
  for f in ${FILES}; do
    fetch "$f" || return 1
  done
  (cd "${TMP}" && grep -E "${PATTERN}" SHA256SUMS | sha256sum -c --quiet -) || return 1
  [ "$(grep -cE "${PATTERN}" "${TMP}/SHA256SUMS")" = 3 ] || return 1

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}/web" "${NEW}/cap"
  gunzip -c "${TMP}/nrzpgp-${ARCH}.gz" > "${NEW}/nrzpgp"
  chmod 755 "${NEW}/nrzpgp"
  tar -xzf "${TMP}/web.tar.gz" -C "${NEW}/web"
  tar -xzf "${TMP}/cap.tar.gz" -C "${NEW}/cap"
  chmod -R a+rX "${NEW}"
  echo "${RELEASE}-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "${RELEASE}-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrzpgp" ]; then
      echo "nrzPGP: ${RELEASE} nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzPGP: Programm nicht von nrzGit (Port 8390) ladbar - ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

mkdir -p "${APP_DIR}/data/db"

# Gemeinsames Geheimnis fuer Server und Cap-Dienst (einmal zufaellig erzeugt). Der Hauptschluessel
# der privaten Schluessel ist davon getrennt (APP_SEED, nur im Server-Container).
if [ ! -s "${APP_DIR}/data/cap.env" ]; then
  SEED="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  umask 077
  printf 'CAP_SEED=%s\nNRZPGP_CAP_SEED=%s\n' "${SEED}" "${SEED}" > "${APP_DIR}/data/cap.env"
fi
chmod 600 "${APP_DIR}/data/cap.env"

# SQLite-Datenbank (pgp.db + WAL) gehoert dem Server-Benutzer 1000.
chown -R 1000:1000 "${APP_DIR}/data/db" 2>/dev/null || true
chmod 700 "${APP_DIR}/data/db" 2>/dev/null || true
