#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzGamePanel kommt ohne eigenes Image und ohne Registry-Login: Programm (Rust) und Oberflaeche
# (Dioxus/WASM) liegen im oeffentlichen Paket-Repo nrzGamePanel-umbrel auf nrzGit auf diesem Geraet
# (Zweig `umbrel`, Tag unten, gebaut mit `cargo xtask umbrel-release` im Repo nrzGamePanel). Beim
# ersten Start und nach Updates werden sie fuer die Architektur dieses Geraets nach app/ geladen
# und geprueft.
RELEASE="umbrel-1.0.1"
BASE="http://localhost:8390/nicorenezweers/nrzGamePanel-umbrel/raw/tag/$umbrel-1.1.0"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzGamePanel: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

FILES="nrz-gamepanel-${ARCH}.gz web.tar.gz"
PATTERN=" nrz-gamepanel-${ARCH}\.gz$| web\.tar\.gz$"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi || { echo "nrzGamePanel: ${BASE}/$1 nicht ladbar" >&2; return 1; }
  }
  fetch SHA256SUMS || return 1
  for f in ${FILES}; do
    fetch "$f" || return 1
  done
  (cd "${TMP}" && grep -E "${PATTERN}" SHA256SUMS | sha256sum -c --quiet -) || return 1
  [ "$(grep -cE "${PATTERN}" "${TMP}/SHA256SUMS")" = 2 ] || return 1

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}/web"
  gunzip -c "${TMP}/nrz-gamepanel-${ARCH}.gz" > "${NEW}/nrz-gamepanel"
  chmod 755 "${NEW}/nrz-gamepanel"
  tar -xzf "${TMP}/web.tar.gz" -C "${NEW}/web"
  chmod -R a+rX "${NEW}"
  echo "$umbrel-1.1.0-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "$umbrel-1.1.0-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrz-gamepanel" ]; then
      echo "nrzGamePanel: $umbrel-1.1.0 nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzGamePanel: Programm nicht von nrzGit (Port 8390) ladbar - ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

# Daten (Server, Backups, Java, Cache) gehoeren dem Panel-Benutzer 1000.
mkdir -p "${APP_DIR}/data"
chown 1000:1000 "${APP_DIR}/data" 2>/dev/null || true
find "${APP_DIR}/data" -maxdepth 2 ! -user 1000 -exec chown 1000:1000 {} + 2>/dev/null || true
