#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzMail kommt ohne eigenes Image und ohne Registry-Login: das Programm (mit Oberflaeche),
# Zertifikate und Rocket.toml liegen im oeffentlichen nrzMail-Repo auf nrzGit auf diesem Geraet (Zweig umbrel,
# Tag unten). Beim ersten Start und nach Updates wird es fuer die Architektur dieses Geraets
# nach app/ geladen und geprueft; der Container (gepinntes debian:trixie-slim) startet es von dort.
RELEASE="umbrel-1.5.0"
BASE="http://localhost:8390/nicorenezweers/nrzMail/raw/tag/${RELEASE}"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzMail: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

mkdir -p "${APP_DIR}/data"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi
  }
  fetch SHA256SUMS && fetch "nrzmail-${ARCH}.gz" && fetch ca-certificates.crt && fetch Rocket.toml || return 1
  (cd "${TMP}" && grep -E " (nrzmail-${ARCH}\.gz|ca-certificates\.crt|Rocket\.toml)$" SHA256SUMS | sha256sum -c --quiet -) || return 1

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}"
  gunzip -c "${TMP}/nrzmail-${ARCH}.gz" > "${NEW}/nrzmail"
  chmod 755 "${NEW}/nrzmail"
  cp "${TMP}/ca-certificates.crt" "${TMP}/Rocket.toml" "${NEW}/"
  chmod 644 "${NEW}/ca-certificates.crt" "${NEW}/Rocket.toml"
  echo "${RELEASE}-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "${RELEASE}-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrzmail" ]; then
      echo "nrzMail: ${RELEASE} nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzMail: Programm nicht von nrzGit (Port 8390) ladbar – ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

# Die Datenbank schreibt der Container als 1000.
chown 1000:1000 "${APP_DIR}/data" 2>/dev/null || true
