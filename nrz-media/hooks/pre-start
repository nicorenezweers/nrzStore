#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# nrzMedia kommt ohne eigenes Image und ohne Registry-Login: Server (mit Oberflaeche),
# statisches ffmpeg, Sprachaufnahmen und Schriften liegen im oeffentlichen Paket-Repo
# nrzMedia-umbrel auf nrzGit auf diesem Geraet (nur fertige Dateien, der Quellcode in
# nrzMedia ist privat; Zweig `umbrel`, Tag unten). Beim ersten Start und nach
# Updates werden sie fuer die Architektur dieses Geraets nach app/ geladen und geprueft;
# der Container (gepinntes debian:trixie-slim) startet sie von dort.
RELEASE="umbrel-1.0.0"
BASE="http://localhost:8390/nicorenezweers/nrzMedia-umbrel/raw/tag/${RELEASE}"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) echo "nrzMedia: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

mkdir -p "${APP_DIR}/data"

download() {
  TMP="$(mktemp -d "${APP_DIR}/.download.XXXXXX")"
  trap 'rm -rf "${TMP}" "${APP_DIR}/app.new"' EXIT

  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL --retry 3 --retry-delay 2 -o "${TMP}/$1" "${BASE}/$1"
    else
      wget -q -O "${TMP}/$1" "${BASE}/$1"
    fi
  }
  for f in SHA256SUMS "nrzmedia-${ARCH}.gz" "ffmpeg-${ARCH}.gz" assets.tar; do
    fetch "$f" || return 1
  done
  (cd "${TMP}" && grep -E " (nrzmedia-${ARCH}\.gz|ffmpeg-${ARCH}\.gz|assets\.tar)$" SHA256SUMS | sha256sum -c --quiet -) || return 1
  # Node-Programme fuer das Selbst-Update der Render-Nodes (ab nrzMedia 2.3, optional)
  NODES=""
  if grep -qE " nodes\.tar$" "${TMP}/SHA256SUMS"; then
    fetch nodes.tar || return 1
    (cd "${TMP}" && grep -E " nodes\.tar$" SHA256SUMS | sha256sum -c --quiet -) || return 1
    NODES=1
  fi

  NEW="${APP_DIR}/app.new"
  rm -rf "${NEW}"
  mkdir -p "${NEW}"
  gunzip -c "${TMP}/nrzmedia-${ARCH}.gz" > "${NEW}/nrzmedia"
  gunzip -c "${TMP}/ffmpeg-${ARCH}.gz" > "${NEW}/ffmpeg"
  tar -xf "${TMP}/assets.tar" -C "${NEW}" --no-same-owner
  if [ -n "${NODES}" ]; then tar -xf "${TMP}/nodes.tar" -C "${NEW}" --no-same-owner; fi
  chmod 755 "${NEW}/nrzmedia" "${NEW}/ffmpeg"
  chmod -R a+rX "${NEW}"
  echo "${RELEASE}-${ARCH}" > "${NEW}/.release"

  rm -rf "${APP_DIR}/app.old"
  if [ -d "${APP_DIR}/app" ]; then mv "${APP_DIR}/app" "${APP_DIR}/app.old"; fi
  mv "${NEW}" "${APP_DIR}/app"
  rm -rf "${APP_DIR}/app.old"
}

if [ "$(cat "${APP_DIR}/app/.release" 2>/dev/null || true)" != "${RELEASE}-${ARCH}" ]; then
  if ! download; then
    # nrzGit nicht erreichbar: mit dem bisherigen Programm weiterlaufen statt gar nicht zu starten
    if [ -x "${APP_DIR}/app/nrzmedia" ]; then
      echo "nrzMedia: ${RELEASE} nicht von nrzGit (Port 8390) ladbar, bisherige Version bleibt" >&2
    else
      echo "nrzMedia: Programm nicht von nrzGit (Port 8390) ladbar – ist die App nrzGit installiert und gestartet?" >&2
      exit 1
    fi
  fi
fi

# Datenbank, Videos und Uploads schreibt der Container als 1000.
chown 1000:1000 "${APP_DIR}/data" 2>/dev/null || true
